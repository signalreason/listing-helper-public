#!/usr/bin/env python3
"""Scan source and current history without printing credential values."""

from __future__ import annotations

import json
import shutil
import subprocess
import sys
import tempfile
from pathlib import Path


def run_scan(arguments: list[str], *, cwd: Path) -> bool:
    # Both output streams can contain secrets. Never upload the raw output.
    with tempfile.TemporaryFile() as output, tempfile.TemporaryFile() as diagnostics:
        result = subprocess.run(
            [
                "trufflehog",
                *arguments,
                "--no-verification",
                "--no-update",
                "--json",
                "--fail",
                "--fail-on-scan-errors",
            ],
            cwd=cwd,
            stdout=output,
            stderr=diagnostics,
            check=False,
        )
        output.seek(0)
        count = 0
        malformed = False
        for raw_line in output:
            try:
                finding = json.loads(raw_line)
                source = finding["SourceMetadata"]["Data"]
                metadata = source.get("Git") or source.get("Filesystem") or {}
                # JSON encoding prevents terminal control characters in paths.
                print(
                    json.dumps(
                        {
                            "file": str(metadata.get("file", "unknown")),
                            "line": metadata.get("line"),
                            "detector": finding.get("DetectorName", "unknown"),
                        }
                    )
                )
                count += 1
            except (ValueError, TypeError, KeyError, AttributeError):
                malformed = True
        if result.returncode not in (0, 183) or malformed:
            print("Secret scan failed. Raw scanner output was suppressed.", file=sys.stderr)
            return False
        if count or result.returncode == 183:
            print("Potential credentials found. Review the locations privately.")
            return False
    return True


def main() -> int:
    if not shutil.which("trufflehog"):
        print("Install TruffleHog 3.97.4 before running this check.", file=sys.stderr)
        return 1
    root = Path(subprocess.check_output(["git", "rev-parse", "--show-toplevel"], text=True).strip())
    shallow = subprocess.check_output(
        ["git", "rev-parse", "--is-shallow-repository"], text=True
    ).strip()
    if shallow == "true":
        print("Fetch the complete checkout history before scanning.", file=sys.stderr)
        return 1
    names = (
        subprocess.check_output(
            ["git", "ls-files", "--cached", "--others", "--exclude-standard", "-z"], cwd=root
        )
        .decode()
        .split("\0")
    )
    with tempfile.TemporaryDirectory(prefix="listing-source-scan-") as directory:
        snapshot = Path(directory)
        for name in set(filter(None, names)):
            source = root / name
            if source.is_symlink():
                print("Source scan does not follow symbolic links.", file=sys.stderr)
                return 1
            if source.is_file():
                destination = snapshot / name
                destination.parent.mkdir(parents=True, exist_ok=True)
                shutil.copyfile(source, destination)
        clean_files = run_scan(["filesystem", str(snapshot)], cwd=root)
    clean_history = run_scan(
        ["git", root.as_uri(), "--branch=HEAD", "--skip-additional-refs"], cwd=root
    )
    if clean_files and clean_history:
        print("No credentials detected in the checkout or its reachable history.")
        return 0
    return 1


if __name__ == "__main__":
    raise SystemExit(main())
